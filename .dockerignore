# Keep build contexts small and free of data, models, outputs and local environments.
.git
.venv
venv
**/__pycache__
.pytest_cache
data
outputs
**/*.csv
# saved models, prediction files and notebook plots, at any depth
**/*.joblib
**/*.pkl
**/*.pickle
**/*.npy
**/*.npz
**/*.png
**/.venv
**/venv
*.ipynb_checkpoints
# secrets (same as .gitignore), at any depth
**/.env
**/*.key
**/*.pem
